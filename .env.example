# Copy to .env.local for local development; set the same keys in Vercel → Project → Settings → Environment Variables.

# Where the application lives (all Start free / Sign in CTAs and legacy path redirects point here)
NEXT_PUBLIC_APP_URL=https://app.researchernet.com

# Canonical site URL (used in metadata, sitemap and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://researchernet.com

# Google Tag Manager container (optional — analytics are off until set)
NEXT_PUBLIC_GTM_ID=

# Resend (https://resend.com) — delivers pilot/contact/investor form submissions by email
RESEND_API_KEY=
FORM_TO_EMAIL=sandip@researchernet.com,asfak@researchernet.com
FORM_FROM_EMAIL=ResearcherNet Website <website@researchernet.com>

# YouTube video id of the product demo (optional)
NEXT_PUBLIC_DEMO_VIDEO_ID=
